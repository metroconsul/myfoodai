# Copie para .env.local e configure SEU projeto Supabase.
# Somente estas duas variáveis públicas são incorporadas ao navegador.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Servidor: mesmo projeto acima. Nunca prefixe secrets com VITE_.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cobrança existente (opcional para iniciar; necessário para checkout/webhook).
# URL pública da aplicação. Em produção, não use localhost.
APP_URL=http://localhost:5173
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Validação facial: API de chat/completions com suporte a imagens.
# Pode ser um servidor open source local compatível, ou provedor escolhido.
# Sem endpoint/modelo, retorna indisponível; não aprova a análise automaticamente.
FACE_VISION_ENDPOINT=
FACE_VISION_MODEL=
FACE_VISION_API_KEY=
# Opcional: sobrescreve a política de cada empresa (vision_api, externo, selfie_evidence).
# FACE_VALIDATION_PROVIDER=vision_api
# FACE_PROVIDER_API_KEY=
# GEOCODING_ENDPOINT=https://nominatim.openstreetmap.org/reverse
# CRON_SECRET=
# CRON_SECRET_PREVIOUS=

# Automação MyFoods ↔ n8n. Todos são server-only; nunca use prefixo VITE_.
# MYFOODS_AUTOMATION_TOKEN=
# N8N_EVENT_WEBHOOK_URL=https://seu-n8n.example/webhook/myfoods/events
# N8N_WEBHOOK_SECRET=

# Testes E2E: use exclusivamente um projeto e colaborador de teste.
# E2E_PORTAL_CPF=
# E2E_PORTAL_PIN=
# E2E_BASE_URL=http://localhost:5173
